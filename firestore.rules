rules_version = '2';

// DEV-ONLY rules: the app has no Auth/role separation yet (see CLAUDE.md
// "Known limitations"), so these allow open read/write to get the scaffold
// working end-to-end. Lock this down (require auth, restrict by role) before
// any real usage — right now anyone with the project config can read/write
// every inspection and vehicle record.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
