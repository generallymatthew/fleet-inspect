rules_version = '2';

// Drivers submit inspections without logging in (FR-1.2 is name-based, not
// auth), so create/update on these collections stays open. Reads are gated
// behind auth since that's the manager dashboard's only real protection
// right now — see CLAUDE.md "Known limitations" for what's still not locked
// down (e.g. vehicle writes aren't yet restricted to admin-only fields).
service cloud.firestore {
  match /databases/{database}/documents {
    match /vehicles/{vehicleId} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    match /inspections/{inspectionId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
